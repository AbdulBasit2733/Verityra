# Redis Connection (Required for BullMQ)
# Local: redis://localhost:6379
# Production: rediss://default:password@host:port (e.g. Upstash)
REDIS_URL="redis://localhost:6379"

# PostgreSQL Database (Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/verityra"
DIRECT_URL="postgresql://postgres:password@localhost:5432/verityra"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.8-flash"

# Supabase Storage (for downloading student answer sheets)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Resend Email (for evaluation completion notifications)
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="evaluations@verityra.com"
NEXT_PUBLIC_APP_URL="https://verityra.com"

# Worker Runtime Configuration
PORT=8080
WORKER_CONCURRENCY=3
EVALUATION_RECOVERY_INTERVAL_MS=180000
