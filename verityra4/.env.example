# ==============================================================================
# VERITYRA ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
NEXT_PUBLIC_BRAND_NAME="Izone"
NEXT_PUBLIC_SUPPORT_EMAIL="support@izone.com"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="verityra_super_secret_jwt_key_change_in_production_min_32_chars"

# Database (Supabase PostgreSQL)
# DATABASE_URL uses the transaction pooler (port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL uses the direct connection (port 5432) for migrations & db push
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Authentication Providers
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AI Evaluation (Google Gemini Multimodal)
# Set this to a model available to your Gemini API account.
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.8-flash"

# Payments (Razorpay)
RAZORPAY_KEY_ID="rzp_test_TthsbbLaadUPXj"
RAZORPAY_KEY_SECRET="vak2Wh4lI50JpsjTPWvlyvwI"
RAZORPAY_WEBHOOK_SECRET="98e2ab575efa2ed02edb525915abe089f374cf2e1e15b2477eecb22536b19066"

# File Storage (options: "local" | "supabase")
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./uploads"

# Optional Supabase Storage configuration
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="verityra-private"

# Initial Admin Seed Credentials
ADMIN_INITIAL_EMAIL="admin@verityra.com"
ADMIN_INITIAL_PASSWORD="AdminSecurePassword123!"
ADMIN_INITIAL_NAME="Verityra Administrator"

# Background evaluation worker
# Keep the worker process continuously running in production.
REDIS_URL="redis://localhost:6379"
# Recovery sweep interval; default is 180000 ms (3 minutes).
EVALUATION_RECOVERY_INTERVAL_MS="180000"
# Number of Gemini evaluations processed concurrently per worker process.
EVALUATION_WORKER_CONCURRENCY="2"

# Email Service (Resend)
# Obtain an API key from https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"
# NOTE: "onboarding@resend.dev" is a sandbox sender that can ONLY deliver to the Resend account owner's email address.
# To deliver emails to real candidate/student recipients, you must verify your custom domain at https://resend.com/domains
# and set RESEND_FROM_EMAIL to a verified address (e.g., "Izone <noreply@yourdomain.com>").
RESEND_FROM_EMAIL="Izone <onboarding@resend.dev>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
